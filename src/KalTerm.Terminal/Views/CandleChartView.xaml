<UserControl x:Class="KalTerm.Terminal.Views.CandleChartView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:markets="clr-namespace:KalTerm.Terminal.Markets"
             xmlns:views="clr-namespace:KalTerm.Terminal.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Swatch" TargetType="Rectangle">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LegendText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="0,8,0,0">
        <DockPanel DockPanel.Dock="Top" LastChildFill="False">
            <TextBlock Text="Interval" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="70" ItemsSource="{Binding Intervals}" SelectedItem="{Binding Interval}" DisplayMemberPath="Text" />
            <TextBlock Text="Range" VerticalAlignment="Center" Margin="16,0,6,0" />
            <ComboBox Width="100" ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" DisplayMemberPath="Text" />
            <Button Content="Reset view" Margin="16,0,0,0" Padding="10,2" Click="OnResetView" ToolTip="Back to showing every candle (the mouse wheel zooms, dragging moves)" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center">
                <Run Text="Last" Foreground="Gray" />
                <Run Text="{Binding LastPriceText, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Source}" Foreground="Gray" VerticalAlignment="Center" />
        </DockPanel>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Rectangle Style="{StaticResource Swatch}" Fill="{x:Static views:ChartBrushes.Rising}" />
            <TextBlock Style="{StaticResource LegendText}" Text="Closed at or above its open" />
            <Rectangle Style="{StaticResource Swatch}" Fill="{x:Static views:ChartBrushes.Falling}" />
            <TextBlock Style="{StaticResource LegendText}" Text="Closed below its open" />
            <Rectangle Style="{StaticResource Swatch}" Fill="{x:Static views:ChartBrushes.Gap}" Opacity="{x:Static markets:ChartColors.GapOpacity}" />
            <TextBlock Style="{StaticResource LegendText}" Text="Data may be missing (a gap)" />
            <Rectangle Style="{StaticResource Swatch}" Fill="{x:Static views:ChartBrushes.Volume}" Opacity="{x:Static markets:ChartColors.VolumeOpacity}" />
            <TextBlock Style="{StaticResource LegendText}" Text="Volume (right axis)" />
            <Line X1="0" X2="18" Y1="6" Y2="6" Width="18" Height="12" Stroke="{x:Static views:ChartBrushes.LastPrice}" StrokeThickness="1.5" StrokeDashArray="3 2" Margin="0,0,5,0" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource LegendText}" Text="Last price" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding HoverText}" Foreground="Gray" MinHeight="20" Margin="0,8,0,4" TextTrimming="CharacterEllipsis" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
        <Grid>
            <wpf:WpfPlot x:Name="Chart" />
            <TextBlock Text="No trades in this range." Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding NothingToShow, Converter={StaticResource Visible}}" />
            <TextBlock Text="Loading…" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                       Visibility="{Binding Loading, Converter={StaticResource Visible}}" />
        </Grid>
    </DockPanel>
</UserControl>
