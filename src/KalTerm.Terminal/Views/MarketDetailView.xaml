<UserControl x:Class="KalTerm.Terminal.Views.MarketDetailView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Right" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <DataTemplate x:Key="Line">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="← Back" Command="{Binding BackCommand}" Padding="10,2" />
            <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
        <TextBlock DockPanel.Dock="Top" Text="Loading…" Foreground="Gray" Margin="0,8,0,0" Visibility="{Binding Loading, Converter={StaticResource Visible}}" />
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Market" FontWeight="Bold" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding About}" ItemTemplate="{StaticResource Line}" />
                    <TextBlock Text="Metrics" FontWeight="Bold" Margin="0,16,0,4" />
                    <ItemsControl ItemsSource="{Binding Metrics}" ItemTemplate="{StaticResource Line}" />
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Ticker updates (newest first, live)" FontWeight="Bold" Margin="0,0,0,4" />
                    <DataGrid ItemsSource="{Binding Ticks}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="190" />
                            <DataGridTextColumn Header="Price" Binding="{Binding Price}" ElementStyle="{StaticResource Right}" Width="70" />
                            <DataGridTextColumn Header="Bid" Binding="{Binding Bid}" ElementStyle="{StaticResource Right}" Width="70" />
                            <DataGridTextColumn Header="Ask" Binding="{Binding Ask}" ElementStyle="{StaticResource Right}" Width="70" />
                            <DataGridTextColumn Header="Bid size" Binding="{Binding BidSize}" ElementStyle="{StaticResource Right}" Width="90" />
                            <DataGridTextColumn Header="Ask size" Binding="{Binding AskSize}" ElementStyle="{StaticResource Right}" Width="90" />
                            <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" ElementStyle="{StaticResource Right}" Width="*" MinWidth="90" />
                            <DataGridTextColumn Header="Open interest" Binding="{Binding OpenInterest}" ElementStyle="{StaticResource Right}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="Trades (newest first, every few seconds)" FontWeight="Bold" Margin="0,0,0,4" />
                    <DataGrid ItemsSource="{Binding Trades}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="190" />
                            <DataGridTextColumn Header="Yes price" Binding="{Binding YesPrice}" ElementStyle="{StaticResource Right}" Width="80" />
                            <DataGridTextColumn Header="Contracts" Binding="{Binding Count}" ElementStyle="{StaticResource Right}" Width="90" />
                            <DataGridTextColumn Header="Taker" Binding="{Binding Side}" Width="70" />
                            <DataGridTextColumn Header="" Binding="{Binding Kind}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
