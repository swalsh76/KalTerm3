<UserControl x:Class="KalTerm.Terminal.Views.AlertsView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="New alert" FontSize="16" FontWeight="SemiBold" />
            <DockPanel Margin="0,8,0,0" LastChildFill="False">
                <TextBlock Text="Market" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Width="220" Text="{Binding Ticker, UpdateSourceTrigger=PropertyChanged}" ToolTip="The ticker of the market" />
                <ComboBox Width="190" Margin="8,0,0,0" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" DisplayMemberPath="Text" />
                <TextBox Width="90" Margin="8,0,0,0" Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Hint}" />
                <TextBlock Text="{Binding Kind.Unit}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Gray" />
                <TextBlock Text="Cooldown" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox Width="60" Text="{Binding Cooldown, UpdateSourceTrigger=PropertyChanged}" ToolTip="The least time between two fires, in seconds (10 to 86400)" />
                <TextBlock Text="seconds" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Gray" />
                <Button Content="Add alert" Command="{Binding AddCommand}" Margin="16,0,0,0" Padding="12,2" />
            </DockPanel>
            <TextBlock Text="{Binding Hint}" Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Problem}" Foreground="DarkGoldenrod" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Error}" Foreground="Firebrick" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,14,0,6" LastChildFill="False">
            <TextBlock Text="Your alerts" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Reread" Command="{Binding RefreshCommand}" Padding="10,2" />
            <CheckBox DockPanel.Dock="Right" Content="Sound" IsChecked="{Binding Sound}" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="Whether the notifications make a sound" />
        </DockPanel>
        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding Alerts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Market" Binding="{Binding Ticker}" Width="2*" MinWidth="180" />
                    <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="*" MinWidth="170" />
                    <DataGridTextColumn Header="Cooldown" Binding="{Binding Cooldown}" Width="90" />
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80" />
                    <DataGridTextColumn Header="Last fired" Binding="{Binding LastFired}" Width="170" />
                    <DataGridTemplateColumn Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding PauseText}" Command="{Binding ToggleCommand}" Padding="10,1" MinWidth="64" />
                                    <Button Content="Delete" Command="{Binding DeleteCommand}" Padding="10,1" Margin="6,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="No alerts yet. Make one above, or choose Create alert… on a market." Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoAlerts, Converter={StaticResource Visible}}" />
        </Grid>
        <TextBlock Grid.Row="3" Text="Recent fires (newest first)" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6" />
        <Grid Grid.Row="4">
            <DataGrid ItemsSource="{Binding Fires}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="170" />
                    <DataGridTextColumn Header="Market" Binding="{Binding Ticker}" Width="2*" MinWidth="180" />
                    <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="*" MinWidth="170" />
                    <DataGridTextColumn Header="Seen" Binding="{Binding Observed}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Nothing has fired yet." Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoFires, Converter={StaticResource Visible}}" />
        </Grid>
    </Grid>
</UserControl>
