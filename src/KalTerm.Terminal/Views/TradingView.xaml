<UserControl x:Class="KalTerm.Terminal.Views.TradingView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Right" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="Environment" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Production}" Value="True">
                    <Setter Property="Foreground" Value="Firebrick" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="{Binding EnvironmentText}" Style="{StaticResource Environment}" />
            <TextBlock Text="{Binding StateText}" Margin="16,0,0,0" VerticalAlignment="Center" />
            <Button Content="Connect" Command="{Binding ConnectCommand}" Margin="12,0,0,0" Padding="12,2" ToolTip="Open the session with Kalshi (it is also opened when the terminal starts)" />
            <Button DockPanel.Dock="Right" Content="KILL SWITCH" Command="{Binding KillCommand}" Padding="16,4" FontWeight="Bold" Foreground="White" Background="Firebrick"
                    ToolTip="Cancel every open order and refuse new orders until Resume" />
            <Button DockPanel.Dock="Right" Content="Resume" Command="{Binding ResumeCommand}" Padding="12,2" Margin="0,0,8,0" Visibility="{Binding Halted, Converter={StaticResource Visible}}" />
            <Button DockPanel.Dock="Right" Content="New order…" Command="{Binding NewOrderCommand}" Padding="14,2" Margin="0,0,8,0" ToolTip="Check an order against your risk limits and send it" />
        </DockPanel>
        <StackPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock Text="{Binding HaltText}" Foreground="Firebrick" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{Binding Halted, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding SyncText}" Foreground="DarkGoldenrod" TextWrapping="Wrap" Visibility="{Binding HasSyncProblem, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding BalanceText}" Margin="0,2,0,0" />
            <WrapPanel Margin="0,2,0,0">
                <TextBlock Text="Open exposure" Foreground="Gray" Margin="0,0,6,0" />
                <TextBlock Text="{Binding ExposureText}" Margin="0,0,20,0" />
                <TextBlock Text="Open orders" Foreground="Gray" Margin="0,0,6,0" />
                <TextBlock Text="{Binding OpenOrdersText}" Margin="0,0,20,0" />
                <TextBlock Text="{Binding DayText}" />
            </WrapPanel>
            <TextBlock Text="{Binding LimitsText}" Foreground="Gray" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasError, Converter={StaticResource Visible}}" />
        </StackPanel>
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8" BorderThickness="1" BorderBrush="Gray" Visibility="{Binding HasAction, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding LastAction}" TextWrapping="Wrap" />
        </Border>

        <TextBlock Grid.Row="3" Text="Resting orders" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,12,0,0" />
        <DataGrid Grid.Row="3" Margin="0,38,0,0" ItemsSource="{Binding Orders}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" CanUserAddRows="False"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Market" Binding="{Binding Ticker}" Width="2*" MinWidth="200" />
                <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="130" />
                <DataGridTextColumn Header="YES price" Binding="{Binding Price}" ElementStyle="{StaticResource Right}" Width="100" />
                <DataGridTextColumn Header="Remaining" Binding="{Binding Remaining}" ElementStyle="{StaticResource Right}" Width="90" />
                <DataGridTextColumn Header="Filled" Binding="{Binding Filled}" ElementStyle="{StaticResource Right}" Width="70" />
                <DataGridTextColumn Header="Shard" Binding="{Binding Shard}" Width="60" />
                <DataGridTemplateColumn Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Change…" Command="{Binding AmendCommand}" Padding="10,1" />
                                <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="10,1" Margin="6,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Positions" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                <DataGrid ItemsSource="{Binding Positions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Market" Binding="{Binding Ticker}" Width="2*" MinWidth="150" />
                        <DataGridTextColumn Header="Position" Binding="{Binding Position}" ElementStyle="{StaticResource Right}" Width="90" />
                        <DataGridTextColumn Header="Exposure" Binding="{Binding Exposure}" ElementStyle="{StaticResource Right}" Width="90" />
                        <DataGridTextColumn Header="Realized" Binding="{Binding Realized}" ElementStyle="{StaticResource Right}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Fills (newest first)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                <DataGrid ItemsSource="{Binding Fills}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="150" />
                        <DataGridTextColumn Header="Market" Binding="{Binding Ticker}" Width="2*" MinWidth="130" />
                        <DataGridTextColumn Header="What" Binding="{Binding What}" Width="70" />
                        <DataGridTextColumn Header="YES price" Binding="{Binding Price}" ElementStyle="{StaticResource Right}" Width="85" />
                        <DataGridTextColumn Header="Count" Binding="{Binding Count}" ElementStyle="{StaticResource Right}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
