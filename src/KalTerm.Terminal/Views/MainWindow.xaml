<Window x:Class="KalTerm.Terminal.Views.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:status="clr-namespace:KalTerm.Terminal.Status"
        xmlns:markets="clr-namespace:KalTerm.Terminal.Markets"
        xmlns:alerts="clr-namespace:KalTerm.Terminal.Alerts"
        xmlns:views="clr-namespace:KalTerm.Terminal.Views"
        Title="KalTerm" Width="1100" Height="720" MinWidth="720" MinHeight="480">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <DataTemplate DataType="{x:Type status:StatusViewModel}">
            <views:StatusView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type markets:MarketsViewModel}">
            <views:MarketsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type alerts:AlertsViewModel}">
            <views:AlertsView />
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{x:Static SystemColors.ControlDarkBrush}">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding ServerText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StateText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <Button Content="Connect…" Command="{Binding ConnectCommand}" Margin="16,0,0,0" Padding="10,2" />
                <Button Content="Retry" Command="{Binding RetryCommand}" Margin="8,0,0,0" Padding="10,2" />
                <TextBlock Text="Layout" Margin="20,0,6,0" VerticalAlignment="Center" />
                <ComboBox Width="130" ItemsSource="{Binding Layouts.Names}" SelectedItem="{Binding Layouts.Current}"
                          ToolTip="How the window, filters and columns are laid out. Changes are saved on the server as you go." />
                <Button Content="Save as…" Command="{Binding Layouts.SaveAsCommand}" Margin="6,0,0,0" Padding="10,2" ToolTip="Save the way things are now under a new layout name" />
                <Button Content="Delete" Command="{Binding Layouts.DeleteCommand}" Margin="6,0,0,0" Padding="10,2" ToolTip="Delete the layout in use" />
                <ComboBox DockPanel.Dock="Right" Width="340" ItemsSource="{Binding Zones}" SelectedItem="{Binding Zone}" DisplayMemberPath="Text"
                          ToolTip="The time zone every time on screen is shown in" />
                <TextBlock DockPanel.Dock="Right" Text="Time zone" Margin="0,0,8,0" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Layouts.Problem}" Foreground="DarkGoldenrod" Margin="12,4,12,0" TextWrapping="Wrap"
                   Visibility="{Binding Layouts.HasProblem, Converter={StaticResource Visible}}" />
        <ListBox DockPanel.Dock="Left" Width="170" ItemsSource="{Binding Navigation}" SelectedItem="{Binding Selected}" DisplayMemberPath="Title" BorderThickness="0,0,1,0" />
        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
</Window>
