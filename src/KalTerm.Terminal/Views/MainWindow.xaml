<Window x:Class="KalTerm.Terminal.Views.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:status="clr-namespace:KalTerm.Terminal.Status"
        xmlns:views="clr-namespace:KalTerm.Terminal.Views"
        Title="KalTerm" Width="1100" Height="720" MinWidth="720" MinHeight="480">
    <Window.Resources>
        <DataTemplate DataType="{x:Type status:StatusViewModel}">
            <views:StatusView />
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{x:Static SystemColors.ControlDarkBrush}">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding ServerText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StateText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <Button Content="Connect…" Command="{Binding ConnectCommand}" Margin="16,0,0,0" Padding="10,2" />
                <Button Content="Retry" Command="{Binding RetryCommand}" Margin="8,0,0,0" Padding="10,2" />
                <ComboBox DockPanel.Dock="Right" Width="340" ItemsSource="{Binding Zones}" SelectedItem="{Binding Zone}" DisplayMemberPath="Text"
                          ToolTip="The time zone every time on screen is shown in" />
                <TextBlock DockPanel.Dock="Right" Text="Time zone" Margin="0,0,8,0" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <ListBox DockPanel.Dock="Left" Width="170" ItemsSource="{Binding Navigation}" SelectedItem="{Binding Selected}" DisplayMemberPath="Title" BorderThickness="0,0,1,0" />
        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
</Window>
