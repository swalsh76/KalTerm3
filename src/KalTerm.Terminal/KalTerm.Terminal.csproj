<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>KalTerm.Terminal</RootNamespace>
    <AssemblyName>KalTerm.Terminal</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF's built-in Windows 11 theme (ThemeMode) is flagged experimental by the SDK: we use it deliberately. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KalTerm.Client\KalTerm.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WPF" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KalTerm.Terminal.Tests" />
  </ItemGroup>
</Project>
