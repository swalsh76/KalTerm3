<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <IsPackable>false</IsPackable>
    <RootNamespace>KalTerm.Terminal.Tests</RootNamespace>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" Condition="'$(NoCoverage)' != 'true'">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KalTerm.Terminal\KalTerm.Terminal.csproj" />
    <ProjectReference Include="..\KalTerm.TestSupport\KalTerm.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Globalization" />
    <Using Include="KalTerm.TestSupport" />
  </ItemGroup>
</Project>
